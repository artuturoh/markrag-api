# MarkRAG API Configuration
PORT=3000
NODE_ENV=development

# Security: RapidAPI Proxy Secret (Optional in local dev, required when deployed to RapidAPI)
RAPIDAPI_PROXY_SECRET=

# Fetcher configuration
FETCH_TIMEOUT_MS=5000
MAX_CONTENT_LENGTH_BYTES=10485760

# Cache configuration (15 minutes = 900000 ms)
CACHE_TTL_MS=900000
CACHE_MAX_ITEMS=1000
